{
  "station://contracts/drafts/project-content": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/drafts/project-content",
    "title": "ProjectContent · 项目内容与短剧制作增量",
    "description": "项目内容草案；短剧多状态、多版本与固定引用增量按已确认 MD/HTML 接入本地实现，生产部署与服务验收另行记录。普通文件属于当前 Manifest；历史输入按 basis_revision_id 解析。结构校验不代替服务端引用、不可变性、权限、人工审核与真实发布结果校验。旧项目可不含制作版本。",
    "type": "object",
    "required": [
      "schema_version",
      "kind",
      "category"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "kind": {
        "const": "project-content"
      },
      "category": {
        "enum": [
          "character",
          "music",
          "video",
          "ai_short_drama"
        ]
      },
      "overview": {
        "$ref": "#/$defs/text"
      },
      "cover_file_id": {
        "$ref": "#/$defs/reference"
      },
      "character": {
        "$ref": "#/$defs/character"
      },
      "music": {
        "$ref": "#/$defs/music"
      },
      "video": {
        "$ref": "#/$defs/video"
      },
      "ai_short_drama": {
        "$ref": "#/$defs/aiShortDrama"
      }
    },
    "oneOf": [
      {
        "required": [
          "character"
        ],
        "properties": {
          "category": {
            "const": "character"
          },
          "character": {
            "type": "object"
          },
          "music": {
            "type": "null"
          },
          "video": {
            "type": "null"
          },
          "ai_short_drama": {
            "type": "null"
          }
        }
      },
      {
        "required": [
          "music"
        ],
        "properties": {
          "category": {
            "const": "music"
          },
          "music": {
            "type": "object"
          },
          "character": {
            "type": "null"
          },
          "video": {
            "type": "null"
          },
          "ai_short_drama": {
            "type": "null"
          }
        }
      },
      {
        "required": [
          "video"
        ],
        "properties": {
          "category": {
            "const": "video"
          },
          "video": {
            "type": "object"
          },
          "character": {
            "type": "null"
          },
          "music": {
            "type": "null"
          },
          "ai_short_drama": {
            "type": "null"
          }
        }
      },
      {
        "required": [
          "ai_short_drama"
        ],
        "properties": {
          "category": {
            "const": "ai_short_drama"
          },
          "ai_short_drama": {
            "type": "object"
          },
          "character": {
            "type": "null"
          },
          "music": {
            "type": "null"
          },
          "video": {
            "type": "null"
          }
        }
      }
    ],
    "$defs": {
      "text": {
        "type": [
          "string",
          "null"
        ]
      },
      "name": {
        "type": "string",
        "pattern": "\\S"
      },
      "id": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "reference": {
        "anyOf": [
          {
            "$ref": "#/$defs/id"
          },
          {
            "type": "null"
          }
        ]
      },
      "seconds": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "references": {
        "type": [
          "array",
          "null"
        ],
        "maxItems": 1000,
        "items": {
          "$ref": "#/$defs/id"
        }
      },
      "key": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "keys": {
        "type": "array",
        "uniqueItems": true,
        "maxItems": 1000,
        "items": {
          "$ref": "#/$defs/key"
        }
      },
      "optionalKey": {
        "anyOf": [
          {
            "$ref": "#/$defs/key"
          },
          {
            "type": "null"
          }
        ]
      },
      "definitionRefs": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file_id"
          ],
          "properties": {
            "file_id": {
              "$ref": "#/$defs/id"
            },
            "anchor": {
              "$ref": "#/$defs/name"
            }
          }
        }
      },
      "contentRef": {
        "$ref": "station://contracts/v2/content-ref"
      },
      "versionFile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "content_ref",
          "purpose"
        ],
        "properties": {
          "file_id": {
            "$ref": "#/$defs/id"
          },
          "content_ref": {
            "$ref": "#/$defs/contentRef"
          },
          "purpose": {
            "$ref": "#/$defs/key"
          }
        }
      },
      "mark": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "part",
          "side",
          "description"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/name"
          },
          "kind": {
            "$ref": "#/$defs/name"
          },
          "part": {
            "$ref": "#/$defs/name"
          },
          "side": {
            "$ref": "#/$defs/name"
          },
          "description": {
            "$ref": "#/$defs/name"
          },
          "reference_refs": {
            "$ref": "#/$defs/definitionRefs"
          }
        }
      },
      "materialState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "definition_refs",
          "marks"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "definition_refs": {
            "$ref": "#/$defs/definitionRefs"
          },
          "marks": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/mark"
            }
          }
        }
      },
      "segment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "order",
          "label"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "$ref": "#/$defs/name"
          }
        }
      },
      "materialVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "basis_revision_id",
          "change_note",
          "file_refs",
          "generation_record_file_ids",
          "review",
          "state_key"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "label": {
            "$ref": "#/$defs/name"
          },
          "basis_revision_id": {
            "$ref": "#/$defs/id"
          },
          "parent_version_key": {
            "$ref": "#/$defs/optionalKey"
          },
          "change_note": {
            "$ref": "#/$defs/name"
          },
          "spatial_record_file_id": {
            "$ref": "#/$defs/reference"
          },
          "lighting_record_file_id": {
            "$ref": "#/$defs/reference"
          },
          "review": {
            "$ref": "#/$defs/review"
          },
          "generation_record_file_ids": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "file_refs": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/versionFile"
            },
            "minItems": 1
          },
          "state_key": {
            "$ref": "#/$defs/key"
          }
        }
      },
      "shotVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "basis_revision_id",
          "change_note",
          "file_refs",
          "generation_record_file_ids",
          "review",
          "purpose",
          "change_record_file_id"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "label": {
            "$ref": "#/$defs/name"
          },
          "basis_revision_id": {
            "$ref": "#/$defs/id"
          },
          "parent_version_key": {
            "$ref": "#/$defs/optionalKey"
          },
          "change_note": {
            "$ref": "#/$defs/name"
          },
          "change_record_file_id": {
            "$ref": "#/$defs/id"
          },
          "spatial_record_file_id": {
            "$ref": "#/$defs/reference"
          },
          "lighting_record_file_id": {
            "$ref": "#/$defs/reference"
          },
          "review": {
            "$ref": "#/$defs/review"
          },
          "generation_record_file_ids": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "file_refs": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/versionFile"
            },
            "minItems": 1
          },
          "purpose": {
            "enum": [
              "whitebox",
              "storyboard",
              "keyframe",
              "segment_video",
              "shot_video"
            ]
          },
          "segment_key": {
            "$ref": "#/$defs/optionalKey"
          }
        }
      },
      "deliverableVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "basis_revision_id",
          "change_note",
          "file_refs",
          "generation_record_file_ids",
          "review",
          "change_record_file_id",
          "composition_file_id"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "label": {
            "$ref": "#/$defs/name"
          },
          "basis_revision_id": {
            "$ref": "#/$defs/id"
          },
          "parent_version_key": {
            "$ref": "#/$defs/optionalKey"
          },
          "change_note": {
            "$ref": "#/$defs/name"
          },
          "change_record_file_id": {
            "$ref": "#/$defs/id"
          },
          "composition_file_id": {
            "$ref": "#/$defs/id"
          },
          "review": {
            "$ref": "#/$defs/review"
          },
          "generation_record_file_ids": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "file_refs": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/versionFile"
            },
            "minItems": 1
          }
        }
      },
      "materialSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_key",
          "purpose",
          "version_key"
        ],
        "properties": {
          "state_key": {
            "$ref": "#/$defs/key"
          },
          "purpose": {
            "$ref": "#/$defs/key"
          },
          "version_key": {
            "$ref": "#/$defs/key"
          }
        }
      },
      "shotSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "version_key"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "whitebox",
              "storyboard",
              "keyframe",
              "segment_video",
              "shot_video"
            ]
          },
          "segment_key": {
            "$ref": "#/$defs/optionalKey"
          },
          "version_key": {
            "$ref": "#/$defs/key"
          }
        }
      },
      "global": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "name"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "kind": {
            "enum": [
              "script",
              "character",
              "wardrobe",
              "prop",
              "location",
              "sound",
              "music"
            ]
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "definition_refs": {
            "$ref": "#/$defs/definitionRefs"
          },
          "definition_review": {
            "$ref": "#/$defs/review"
          },
          "input_global_keys": {
            "$ref": "#/$defs/keys"
          },
          "generation_record_file_ids": {
            "$ref": "#/$defs/references"
          },
          "file_ids": {
            "$ref": "#/$defs/references"
          },
          "reference_file_ids": {
            "$ref": "#/$defs/references"
          },
          "review": {
            "$ref": "#/$defs/review"
          },
          "asset_id": {
            "$ref": "#/$defs/reference"
          },
          "asset_version_id": {
            "$ref": "#/$defs/reference"
          },
          "states": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/materialState"
            }
          },
          "versions": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/materialVersion"
            }
          },
          "selected_versions": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/materialSelection"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "definition_review"
              ],
              "properties": {
                "definition_review": {
                  "properties": {
                    "state": {
                      "const": "approved"
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "definition_refs"
              ],
              "properties": {
                "definition_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "oneOf": [
              {
                "required": [
                  "asset_id",
                  "asset_version_id"
                ],
                "properties": {
                  "asset_id": {
                    "$ref": "#/$defs/id"
                  },
                  "asset_version_id": {
                    "$ref": "#/$defs/id"
                  }
                }
              },
              {
                "properties": {
                  "asset_id": {
                    "type": "null"
                  },
                  "asset_version_id": {
                    "type": "null"
                  }
                }
              }
            ]
          },
          {
            "if": {
              "required": [
                "review"
              ],
              "properties": {
                "review": {
                  "properties": {
                    "state": {
                      "const": "approved"
                    }
                  }
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "file_ids"
                  ],
                  "properties": {
                    "file_ids": {
                      "type": "array",
                      "minItems": 1
                    }
                  }
                },
                {
                  "required": [
                    "asset_id",
                    "asset_version_id"
                  ],
                  "properties": {
                    "asset_id": {
                      "$ref": "#/$defs/id"
                    },
                    "asset_version_id": {
                      "$ref": "#/$defs/id"
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "usageTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "episode_key"
        ],
        "properties": {
          "episode_key": {
            "$ref": "#/$defs/key"
          },
          "scene_key": {
            "$ref": "#/$defs/key"
          },
          "shot_key": {
            "$ref": "#/$defs/key"
          }
        },
        "dependentRequired": {
          "shot_key": [
            "scene_key"
          ]
        }
      },
      "usage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "global_key",
          "target"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "global_key": {
            "$ref": "#/$defs/key"
          },
          "target": {
            "$ref": "#/$defs/usageTarget"
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "state_key": {
            "$ref": "#/$defs/optionalKey"
          },
          "version_key": {
            "$ref": "#/$defs/optionalKey"
          },
          "segment": {
            "anyOf": [
              {
                "$ref": "#/$defs/segment"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "deliverable": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "title": {
            "$ref": "#/$defs/name"
          },
          "episode_key": {
            "$ref": "#/$defs/optionalKey"
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "file_ids": {
            "$ref": "#/$defs/references"
          },
          "review": {
            "$ref": "#/$defs/review"
          },
          "versions": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/deliverableVersion"
            }
          },
          "selected_version_key": {
            "$ref": "#/$defs/optionalKey"
          },
          "delivery_record_file_ids": {
            "$ref": "#/$defs/references"
          }
        },
        "if": {
          "required": [
            "review"
          ],
          "properties": {
            "review": {
              "properties": {
                "state": {
                  "const": "approved"
                }
              }
            }
          }
        },
        "then": {
          "required": [
            "file_ids"
          ],
          "properties": {
            "file_ids": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      },
      "worldCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "source"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "key"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "global",
                  "deliverable"
                ]
              },
              "key": {
                "$ref": "#/$defs/key"
              }
            }
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "review": {
            "$ref": "#/$defs/review"
          },
          "registration_request": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "station://contracts/v2/world-register-request"
              }
            ]
          },
          "registration_status": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "station://contracts/v2/world-status"
              }
            ]
          },
          "publication_record_file_id": {
            "$ref": "#/$defs/reference"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "registration_request"
              ],
              "properties": {
                "registration_request": {
                  "type": "object"
                }
              }
            },
            "then": {
              "required": [
                "review"
              ],
              "properties": {
                "review": {
                  "properties": {
                    "state": {
                      "const": "approved"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "registration_status"
              ],
              "properties": {
                "registration_status": {
                  "type": "object"
                }
              }
            },
            "then": {
              "required": [
                "registration_request"
              ],
              "properties": {
                "registration_request": {
                  "type": "object"
                }
              }
            }
          }
        ]
      },
      "runRef": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "service_id",
          "run_id"
        ],
        "properties": {
          "service_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "run_id": {
            "$ref": "#/$defs/name"
          }
        }
      },
      "review": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "enum": [
              "unreviewed",
              "in_review",
              "approved",
              "rejected"
            ]
          },
          "record_file_id": {
            "$ref": "#/$defs/reference"
          }
        },
        "if": {
          "properties": {
            "state": {
              "const": "approved"
            }
          }
        },
        "then": {
          "required": [
            "record_file_id"
          ],
          "properties": {
            "record_file_id": {
              "$ref": "#/$defs/id"
            }
          }
        }
      },
      "continuity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "kind"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/key"
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "kind": {
            "enum": [
              "character",
              "wardrobe",
              "location",
              "prop",
              "voice",
              "general"
            ]
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "reference_file_ids": {
            "$ref": "#/$defs/references"
          },
          "definition_refs": {
            "$ref": "#/$defs/definitionRefs"
          },
          "global_keys": {
            "$ref": "#/$defs/keys"
          },
