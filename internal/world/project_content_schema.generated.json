  "station://contracts/v2/content-ref": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/v2/content-ref",
    "title": "ContentRef",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "store_id",
      "artifact_id",
      "version_id"
    ],
    "properties": {
      "store_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "artifact_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "version_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    }
  },
  "station://contracts/v2/world-register-request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/v2/world-register-request",
    "title": "WorldRegisterRequest",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "commit_id",
      "source_project_id",
      "source_revision_id",
      "file_ids",
      "name",
      "asset_type",
      "subjects",
      "relation"
    ],
    "properties": {
      "commit_id": {
        "$ref": "content-ref.schema.json#/properties/store_id"
      },
      "source_project_id": {
        "$ref": "content-ref.schema.json#/properties/store_id"
      },
      "source_revision_id": {
        "$ref": "content-ref.schema.json#/properties/store_id"
      },
      "file_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10000,
        "items": {
          "$ref": "content-ref.schema.json#/properties/store_id"
        },
        "uniqueItems": true
      },
      "name": {
        "$ref": "asset-version-manifest.schema.json#/properties/name"
      },
      "asset_type": {
        "$ref": "asset-version-manifest.schema.json#/properties/asset_type"
      },
      "subjects": {
        "$ref": "asset-version-manifest.schema.json#/properties/subjects"
      },
      "relation": {
        "enum": [
          "produced_in",
          "curated_in"
        ]
      },
      "asset_id": {
        "$ref": "content-ref.schema.json#/properties/store_id"
      },
      "expected_asset_version_id": {
        "$ref": "content-ref.schema.json#/properties/store_id"
      },
      "review_file_id": {
        "$ref": "content-ref.schema.json#/properties/store_id"
      },
      "depends_on": {
        "$ref": "asset-version-manifest.schema.json#/properties/depends_on"
      }
    },
    "dependentRequired": {
      "asset_id": [
        "expected_asset_version_id"
      ],
      "expected_asset_version_id": [
        "asset_id"
      ]
    }
  },
  "station://contracts/v2/asset-version-manifest": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/v2/asset-version-manifest",
    "title": "AssetVersionManifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "kind",
      "asset_id",
      "name",
      "asset_type",
      "subjects",
      "files",
      "source",
      "depends_on"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "kind": {
        "const": "asset-version"
      },
      "asset_id": {
        "$ref": "#/$defs/id"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "asset_type": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "subjects": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "maxItems": 256
      },
      "files": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/file"
        },
        "maxItems": 10000
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "project_revision_id",
          "relation"
        ],
        "properties": {
          "project_id": {
            "$ref": "#/$defs/id"
          },
          "project_revision_id": {
            "$ref": "#/$defs/id"
          },
          "relation": {
            "enum": [
              "produced_in",
              "curated_in"
            ]
          },
          "review_file_id": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "depends_on": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/assetRef"
        },
        "maxItems": 10000
      },
      "extensions": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_.-]*$"
        }
      }
    },
    "$defs": {
      "id": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "relativePath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!\\.vf(?:/|$))(?!.*[. ](?:/|$))(?!.*\\/$)[^\\u0000-\\u001f\\u007f\\\\<>:\"|?*]+$"
      },
      "contentRef": {
        "$ref": "content-ref.schema.json"
      },
      "file": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "path",
          "role",
          "content_ref"
        ],
        "properties": {
          "file_id": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "content_ref": {
            "$ref": "#/$defs/contentRef"
          }
        }
      },
      "assetRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "asset_version_id",
          "purpose"
        ],
        "properties": {
          "asset_id": {
            "$ref": "#/$defs/id"
          },
          "asset_version_id": {
            "$ref": "#/$defs/id"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  },
  "station://contracts/v2/world-status": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/v2/world-status",
    "title": "WorldCommitStatus",
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_sha256",
          "state"
        ],
        "properties": {
          "request_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "const": "preparing"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_sha256",
          "state",
          "result"
        ],
        "properties": {
          "request_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "const": "committed"
          },
          "result": {
            "$ref": "world-result.schema.json"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_sha256",
          "state",
          "error_code",
          "current_asset_version_id"
        ],
        "properties": {
          "request_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "const": "conflict"
          },
          "error_code": {
            "const": "REVISION_CONFLICT"
          },
          "current_asset_version_id": {
            "$ref": "content-ref.schema.json#/properties/store_id"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_sha256",
          "state",
          "error_code"
        ],
        "properties": {
          "request_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "const": "failed"
          },
          "error_code": {
            "enum": [
              "INVALID_ARGUMENT",
              "NOT_FOUND",
              "PERMISSION_DENIED",
              "CONTENT_NOT_READY"
            ]
          }
        }
      }
    ]
  },
