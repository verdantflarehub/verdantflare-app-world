  {
    "name": "world.analyze",
    "description": "Submit one complete World analysis with fixed source, model prompt targets and total budget; query capabilities, recover progress, explicitly retry one failed observation or cross-segment association with a stable retry_id, and read the fixed learning revision without a project.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "WorldAnalyzeRequest",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "capabilities"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "submit"
            },
            "task_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "draft_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "revision_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "file_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "required": [
                "draft_id",
                "revision_id",
                "file_id"
              ]
            },
            "model_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
            },
            "budget_limit": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,8})?$",
              "maxLength": 18
            },
            "budget_per_call": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,8})?$",
              "maxLength": 18
            },
            "prompt_targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "requested_label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "task_type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "input_mode": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "model_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "adaptation_guidance": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "key",
                  "requested_label",
                  "task_type",
                  "input_mode",
                  "adaptation_guidance"
                ]
              }
            }
          },
          "required": [
            "mode",
            "task_id",
            "source",
            "model_id",
            "budget_limit",
            "budget_per_call",
            "prompt_targets"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "get"
            },
            "task_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "mode",
            "task_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "list"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "before_task_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "retry"
            },
            "task_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "retry_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "mode",
            "task_id",
            "retry_id"
          ]
        }
      ],
      "type": "object"
    }
  },
  {
    "name": "world.draft",
    "description": "Create, list, read, commit or recover private World references and editable learning/creation drafts without a project; move collections to trash or restore them with lifecycle version and operation_id, preserving fixed sources. Native-run verification depends on available service support.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "WorldDraftRequest",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "commit_id",
            "name",
            "purpose",
            "subjects"
          ],
          "properties": {
            "mode": {
              "const": "create"
            },
            "commit_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "purpose": {
              "enum": [
                "collection",
                "learning",
                "creation"
              ]
            },
            "subjects": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "list"
            },
            "purpose": {
              "enum": [
                "collection",
                "learning",
                "creation"
              ]
            },
            "q": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "lifecycle_state": {
              "enum": [
                "active",
                "trashed"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "lifecycle_state"
                ],
                "properties": {
                  "lifecycle_state": {
                    "const": "trashed"
                  }
                }
              },
              "then": {
                "required": [
                  "purpose"
                ],
                "properties": {
                  "purpose": {
                    "const": "collection"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "draft_id"
          ],
          "properties": {
            "mode": {
              "const": "get"
            },
            "draft_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "revision_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "draft_id",
            "expected_revision_id",
            "commit_id",
            "manifest"
          ],
          "properties": {
            "mode": {
              "const": "commit"
            },
            "draft_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "expected_revision_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "commit_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "manifest": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "WorldDraftManifest",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "kind",
                "draft_id",
                "purpose",
                "name",
                "subjects",
                "files",
                "domain_documents",
                "source_refs",
                "asset_refs",
                "run_refs"
              ],
              "properties": {
                "schema_version": {
                  "const": 1
                },
                "kind": {
                  "const": "world-draft"
                },
                "draft_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "purpose": {
                  "enum": [
                    "collection",
                    "learning",
                    "creation"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "subjects": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "maxItems": 256
                },
                "files": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 10000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "file_id",
                      "path",
                      "role",
                      "content_ref"
                    ],
                    "properties": {
                      "file_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "path": {
                        "type": "string",
