    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "WorldListRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "asset_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cursor": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "domain": {
          "type": "string",
          "enum": [
            "character",
            "pose",
            "costume",
            "scene",
            "sound",
            "music",
            "shot",
            "script",
            "knowledge"
          ]
        },
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "relation": {
          "type": "string",
          "enum": [
            "curated_in",
            "produced_in"
          ]
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "facets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^:]{1,32}$"
          }
        },
        "preview_hint": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        }
      }
    }
  },
